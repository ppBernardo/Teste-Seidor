{
  "name": "controle-automoveis-api",
  "version": "1.0.0",
  "description": "WebAPI para controle de utilização de automóveis por motoristas de uma empresa",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "nodejs",
    "express",
    "api",
    "automoveis",
    "motoristas"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
